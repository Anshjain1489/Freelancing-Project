# Environment Configuration — Chaudhary Kirana Store Platform
NODE_ENV=development
PORT=5000

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Security Secrets
JWT_ACCESS_SECRET=your-jwt-access-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key

# Google OAuth Sign-In Client ID
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# WhatsApp Business Cloud API Configuration (Optional — set to false to disable)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=chaudhary_kirana_wa_verify_2026
WHATSAPP_APP_SECRET=your_whatsapp_app_secret
WHATSAPP_API_VERSION=v18.0
ADMIN_WHATSAPP_NUMBERS=7897837095,7007550184

# Notification Retry Policy
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_DELAY_SECONDS=60

# Store Business Information
STORE_NAME="Chaudhary Kirana Store"
STORE_OWNER="Akash Chaudhary"
PRIMARY_PHONE="7897837095"
SECONDARY_PHONE="7007550184"
STORE_ADDRESS="Near Bada Jain Mandir, Tikamgarh Road, Mahruni, India"
STORE_LATITUDE=24.2381
STORE_LONGITUDE=78.7364
FREE_DELIVERY_RADIUS_KM=1.0
DELIVERY_CHARGE_PER_EXTRA_KM=10.0
MAX_DELIVERY_RADIUS_KM=15.0
