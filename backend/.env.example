# Chaudhary Kirana Store — Backend Production Environment Template
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://chaudharykiranastore.com

# PostgreSQL / Supabase Database Configuration
DATABASE_URL=postgresql://user:password@db.example.supabase.co:5432/postgres
SUPABASE_URL=https://your-app.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Security Secrets (Minimum 32 random characters in production)
JWT_ACCESS_SECRET=your_production_jwt_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_min_32_chars_long
JWT_ISSUER=chaudhary-kirana-api
JWT_AUDIENCE=chaudhary-kirana-clients

# Google OAuth Sign-In Client ID
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# WhatsApp Business Cloud API (Optional)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=chaudhary_kirana_wa_verify_2026
ADMIN_WHATSAPP_NUMBERS=7897837095,7007550184

# Store Business Information
STORE_NAME="Chaudhary Kirana Store"
STORE_OWNER="Akash Chaudhary"
PRIMARY_PHONE="7897837095"
SECONDARY_PHONE="7007550184"
STORE_ADDRESS="Near Bada Jain Mandir, Tikamgarh Road, Mahruni, India"
STORE_LATITUDE=24.2381
STORE_LONGITUDE=78.7364
FREE_DELIVERY_RADIUS_KM=0.0
DELIVERY_CHARGE_PER_EXTRA_KM=10.0
MAX_DELIVERY_RADIUS_KM=15.0

# AI Chatbot Provider Configuration
AI_ENABLED=true
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_ai_api_key
AI_MODEL=gemini-1.5-flash

# Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
