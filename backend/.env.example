# Chaudhary Kirana Store — Production Environment Configuration Template
# DO NOT put real credentials or secrets in this file.

# PUBLIC / CLIENT-SAFE SETTINGS
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://chaudharykiranastore.com

# PUBLIC / CLIENT-SAFE SUPABASE SETTINGS
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# SERVER-ONLY PRIVILEGED SUPABASE SECRET
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# AUTHENTICATION-SECRETS (Must be >=32 characters, unique, and generated securely via crypto.randomBytes)
JWT_ACCESS_SECRET=replace-with-a-unique-32-plus-character-access-secret
JWT_REFRESH_SECRET=replace-with-a-unique-32-plus-character-refresh-secret
JWT_ISSUER=chaudhary-kirana-api
JWT_AUDIENCE=chaudhary-kirana-clients

# DATABASE-SECRET (PostgreSQL Connection String — IPv4 Pooler recommended for CI/CD environments)
DATABASE_URL=postgresql://postgres.projectref:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# GOOGLE OAUTH & MAPS SETTINGS
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=

# PAYMENT GATEWAY SETTINGS
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# STORE BUSINESS SETTINGS
STORE_NAME="Chaudhary Kirana Store"
STORE_OWNER="Akash Chaudhary"
PRIMARY_PHONE="7897837095"
SECONDARY_PHONE="7007550184"
STORE_ADDRESS="Near Bada Jain Mandir, Tikamgarh Road, Mahruni, India"
STORE_LATITUDE=24.2381
STORE_LONGITUDE=78.7364
FREE_DELIVERY_RADIUS_KM=0.0
DELIVERY_CHARGE_PER_EXTRA_KM=10.0
MAX_DELIVERY_RADIUS_KM=15.0

# AI CHATBOT PROVIDER
AI_ENABLED=true
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
