# =================================================================
# CHAUDHARY KIRANA STORE - BACKEND PRODUCTION ENVIRONMENT TEMPLATE
# =================================================================

NODE_ENV=production
PORT=5000
FRONTEND_URL=https://chaudharykiranastore.com
PUBLIC_APP_URL=https://chaudharykiranastore.com

# Database Connection (Supabase Transaction Pooler or Direct PostgreSQL)
# Format: postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.example:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Project Credentials
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# Cryptographically Generated JWT Secrets (Minimum 32 Characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
JWT_ISSUER=chaudhary-kirana-api
JWT_AUDIENCE=chaudhary-kirana-clients

# Optional Payment Gateway Integration (Razorpay)
RAZORPAY_KEY_ID=rzp_live_example_key_id
RAZORPAY_KEY_SECRET=example_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=example_razorpay_webhook_secret

# Store Operations Configuration
STORE_NAME=Chaudhary Kirana Store
STORE_OWNER=Akash Chaudhary
PRIMARY_PHONE=7897837095
SECONDARY_PHONE=7007550184
STORE_ADDRESS=Near Bada Jain Mandir, Tikamgarh Road, Mahruni, Uttar Pradesh 284405
STORE_LATITUDE=24.2381
STORE_LONGITUDE=78.7364
MIN_ORDER_VALUE=199.0
FREE_DELIVERY_RADIUS_KM=0.0
DELIVERY_CHARGE_PER_EXTRA_KM=10.0
MAX_DELIVERY_RADIUS_KM=15.0

# Monitoring & Security Limits
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
